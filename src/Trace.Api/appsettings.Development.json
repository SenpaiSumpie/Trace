{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    }
  },
  "ConnectionStrings": {
    "Trace": "Host=localhost;Port=54320;Database=trace;Username=trace;Password=local-dev-only-change-me"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true
  },
  "Demo": {
    "FixturePath": "../../tests/fixtures/sample-repo",
    "IssuesPath": "../../tests/fixtures/sample-repo.issues"
  },
  "Embeddings": {
    "Provider": "deterministic-fake"
  },
  "Chat": {
    "Provider": "deterministic-fake"
  },
  "Auth": {
    "AllowAnonymousWrites": true
  },
  "RateLimits": {
    "WritesPerMinute": 600
  },
  "Jobs": {
    "ProcessInThisHost": true
  }
}
