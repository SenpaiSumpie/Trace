# API_UPSTREAM (for example http://api:8080) is substituted when the container starts.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Everything the app loads is its own: no inline scripts, no third-party hosts.
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Keep the scheme the outer proxy saw (TLS ends there), falling back to our own.
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        client_max_body_size 6m;
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    # Not an address of the app and not one of the API: never answered with the app's page.
    location = /api {
        return 404;
    }

    # A missing script, style or font is a 404, not the app's page under another name.
    location /assets/ {
        try_files $uri =404;
    }

    # The app has addresses of its own (/history, /investigations/{id}, /plans/{id}; ADR-021).
    # Any path that is not a file is answered with the app, which shows the page or "not found".
    location / {
        try_files $uri /index.html;
    }
}
